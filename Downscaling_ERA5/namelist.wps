&share
 wrf_core = 'ARW',
 max_dom = 3,
 start_date       = '2015-07-30_00:00:00','2015-07-30_00:00:00','2015-07-30_00:00:00',
 end_date         = '2015-07-31_00:00:00','2015-07-31_00:00:00','2015-07-31_00:00:00',
 interval_seconds = 3600
 io_form_geogrid  = 2
