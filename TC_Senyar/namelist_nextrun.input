&time_control
 run_days                            = 11,
 run_hours                           = 23,
 run_minutes                         = 0,
 run_seconds                         = 0,
 start_year                          = 2025, 2025,
 start_month                         = 11,   11,
 start_day                           = 20,   20,
 start_hour                          = 00,   00,
 end_year                            = 2025, 2025,
 end_month                           = 12,   12,
 end_day                             = 01,   01,
 end_hour                            = 23,   23,
 interval_seconds                    = 3600,
 input_from_file                     = .true., .true.,
 history_interval                    = 60,     60,
 frames_per_outfile                  = 24,     24,
 restart                             = .true.,
 restart_interval                    = 720,
 io_form_history                     = 2,
 io_form_restart                     = 2,
 io_form_input                       = 2,
 io_form_boundary                    = 2,
 ! --- SST UPDATE AUXINPUT4 ---
 auxinput4_inname                    = "wrflowinp_d<domain>",
 auxinput4_interval                  = 60,     60,
 io_form_auxinput4                   = 2,
/

&namelist_quilt
 nio_tasks_per_group                 = 0,
 nio_groups                          = 1,
/

&domains
 ! D01 = 10 km; D02 = 10/3 = 3.333333 km
 time_step                           = 60,
 time_step_fract_num                 = 0,
 time_step_fract_den                 = 1,
 max_dom                             = 2,
 e_we                                = 1228, 2593,
 e_sn                                = 812,  1492,
 e_vert                              = 60,   60,
 p_top_requested                     = 10000,
 num_metgrid_levels                  = 61,
 num_metgrid_soil_levels             = 4,
 dx                                  = 10000., 3333.333333,
 dy                                  = 10000., 3333.333333,
 grid_id                             = 1,     2,
 parent_id                           = 1,     1,
 i_parent_start                      = 1,     178,
 j_parent_start                      = 1,     147,
 parent_grid_ratio                   = 1,     3,
 parent_time_step_ratio              = 1,     3,
 feedback                            = 1,
 smooth_option                       = 0,
/

&physics
 ! Skema dipertahankan dari namelist.input asli.
 mp_physics                          = 2,     2,     ! Purdue-Lin
 ra_lw_physics                       = 4,     4,     ! RRTMG
 ra_sw_physics                       = 4,     4,     ! RRTMG
 ! Interval radiasi disesuaikan dengan resolusi ~1 menit per km.
 radt                                = 10,    3,
 sf_sfclay_physics                   = 1,     1,     ! Revised MM5
 sf_surface_physics                  = 2,     2,     ! Noah LSM
 bl_pbl_physics                      = 1,     1,     ! YSU
 bldt                                = 0,     0,
 cu_physics                          = 2,     0,     ! BMJ D01; explicit convection D02
 cudt                                = 5,     5,
 isfflx                              = 1,
 ifsnow                              = 1,
 icloud                              = 1,
 surface_input_source                = 3,
 num_soil_layers                     = 4,
 sst_update                          = 1,
 sf_urban_physics                    = 0,     0,
/

&dynamics
 ! Opsi dinamika dipertahankan dari namelist.input asli.
 w_damping                           = 1,
 diff_opt                            = 1,      1,
 km_opt                              = 4,      4,
 diff_6th_opt                        = 0,      0,
 diff_6th_factor                     = 0.12,   0.12,
 base_temp                           = 290.,
 damp_opt                            = 3,
 zdamp                               = 5000.,  5000.,
 dampcoef                            = 0.2,    0.2,
 khdif                               = 0,      0,
 kvdif                               = 0,      0,
 non_hydrostatic                     = .true., .true.,
 moist_adv_opt                       = 1,      1,
 scalar_adv_opt                      = 1,      1,
 gwd_opt                             = 1,      0,
/

&bdy_control
 spec_bdy_width                      = 5,
 specified                           = .true.,  .false.,
 nested                              = .false., .true.,
/
